# Пароль администратора для первого входа (логин: admin). Потом смените его в админке.
ADMIN_PASSWORD=

# Подключение к PostgreSQL. На Pipecore подставляется автоматически из подключённой базы.
# Без этой переменной сайт хранит всё в локальном файле data/cfbaza.sqlite3 (для проверки на своём компьютере).
DATABASE_URL=

# Письма о заявках через Яндекс.Почту. Адрес получателя задаётся в админке («Уведомления о заявках»).
# Пароль — это «пароль приложения»: id.yandex.ru → Безопасность → Пароли приложений → Почта.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=Dadyfedor@yandex.ru
SMTP_PASSWORD=

# Уведомления в Telegram (необязательно): токен бота от @BotFather и chat_id получателя.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
